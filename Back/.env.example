# ─── KASCON Backend Environment ─────────────────────────────────────────────
# Copy this file to .env and fill in the values before starting the server.
# NEVER commit .env to version control.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Must be a live Atlas URI — local MongoDB is intentionally blocked.
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.hzxlozt.mongodb.net/<dbname>?retryWrites=true&w=majority

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string

# ── CORS ──────────────────────────────────────────────────────────────────────
# Space or comma-separated list of allowed origins (your Vercel frontend URL).
CLIENT_URL=https://kassconcp.vercel.app

# ── Media ─────────────────────────────────────────────────────────────────────
# The public origin used to build absolute media URLs stored in the database.
# Defaults to https://kassconbackend.onrender.com if unset.
# MEDIA_URL=https://kassconbackend.onrender.com

# ── Admin credentials (used by the seed script, not the server itself) ────────
ADMIN_EMAIL=admin@kasconplc.com
ADMIN_PASSWORD=change_me

# ── Company Profile PDF ───────────────────────────────────────────────────────
# Optional: base URL of the frontend public assets so the PDF can embed
# committed static images (/media/home/hero.jpg etc.)
# PUBLIC_MEDIA_URL=https://kassconcp.vercel.app

# ── Static assets fallback ───────────────────────────────────────────────────
# Optional: absolute path to the frontend `public` directory so the PDF
# service can find committed /media/* images locally during development.
# CLIENT_PUBLIC_DIR=/path/to/client/public

# ── Migration scripts ─────────────────────────────────────────────────────────
# Optional: base URL used by the migrateUploads.js script to recover
# legacy /uploads files that no longer exist locally.
# REMOTE_UPLOADS_BASE=https://kassconbackend.onrender.com

# -- Vercel Deploy Hook --------------------------------------------------------
# Optional: triggers a Vercel rebuild when the admin saves settings, services,
# or projects -- so the static prerender snapshot stays fresh.
# Get the URL from: Vercel -> Project Settings -> Git -> Deploy Hooks.
# NEVER commit the real URL to version control.
# VERCEL_DEPLOY_HOOK_URL=
